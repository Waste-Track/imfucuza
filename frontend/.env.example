# Supabase project the Engine verifies sign-in tokens against.
# Local: `supabase status` in ../backend prints both values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Engine's public URL. Leave empty in development: Vite proxies /v1 to :8000.
VITE_API_URL=
